# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Never commit .env to Git (it is already in .gitignore).

# Port the API listens on. Nginx forwards HTTPS traffic to this port.
PORT=3000

# --- Database ---
# Local:  DB_HOST=localhost
# AWS:    DB_HOST=<your RDS endpoint>, e.g. task-db.abc123xyz.ap-southeast-1.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taskmanager

# Encrypt the connection to the database. Use true on AWS RDS, false locally.
DB_SSL=false

# --- CORS ---
# The website(s) allowed to call this API, comma separated, no trailing slash.
# Leave empty during local development (allows everything).
# AWS: CORS_ORIGIN=https://main.d1234abcd.amplifyapp.com
CORS_ORIGIN=
